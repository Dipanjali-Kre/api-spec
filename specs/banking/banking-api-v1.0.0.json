{
  "openapi": "3.0.0",
  "info": {
    "title": "banking",
    "description": "API specification for the banking service, providing endpoints for managing accounts, transactions, and user data.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Production server for the banking API."
    },
    {
      "url": "https://dev.example.com/v1",
      "description": "Development server for testing and integration."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Check API health status",
        "description": "Provides a simple health check endpoint to determine if the API is operational and responsive. This endpoint does not require authentication.",
        "operationId": "getHealthStatus",
        "responses": {
          "200": {
            "description": "API is healthy and operational.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                },
                "examples": {
                  "healthy": {
                    "value": {
                      "status": "UP",
                      "timestamp": "2023-10-27T10:00:00Z"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error indicating the API is unhealthy or experiencing issues.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unhealthy": {
                    "value": {
                      "code": "SERVICE_UNAVAILABLE",
                      "message": "The banking service is currently experiencing internal issues and cannot process requests."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "description": "Represents the health status of the API.",
        "properties": {
          "status": {
            "type": "string",
            "description": "The overall health status of the API.",
            "enum": [
              "UP",
              "DOWN",
              "DEGRADED"
            ],
            "example": "UP"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the health check was performed.",
            "example": "2023-10-27T10:00:00Z"
          }
        },
        "required": [
          "status",
          "timestamp"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error response format for API errors.",
        "properties": {
          "code": {
            "type": "string",
            "description": "A unique, programmatic error code.",
            "example": "INVALID_INPUT"
          },
          "message": {
            "type": "string",
            "description": "A human-readable message describing the error.",
            "example": "The provided input is invalid. Please check your request."
          },
          "details": {
            "type": "array",
            "description": "Optional array of detailed error messages or validation issues.",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "The field that caused the error (if applicable).",
                  "example": "amount"
                },
                "issue": {
                  "type": "string",
                  "description": "Specific issue with the field.",
                  "example": "must be a positive number"
                }
              }
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Bearer token authentication using a JSON Web Token (JWT)."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API Key authentication, passed in the 'X-API-Key' request header."
      },
      "OAuth2ClientCredentials": {
        "type": "oauth2",
        "description": "OAuth 2.0 Client Credentials flow for machine-to-machine authentication.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.example.com/oauth/token",
            "scopes": {
              "accounts:read": "Read access to user accounts",
              "transactions:write": "Write access to user transactions"
            }
          }
        }
      }
    }
  }
}