{
  "openapi": "3.0.3",
  "info": {
    "title": "Healthcare Plus Platform API",
    "version": "2.0.0",
    "description": "A comprehensive RESTful API for managing patient data, appointments, medical records, and prescriptions within a multi-tenant hospital system. This API is designed with HIPAA compliance in mind, ensuring secure handling of Protected Health Information (PHI) through robust access controls, audit logging, and encryption. It adheres to HL7 FHIR-compatible resource naming conventions and supports role-based access for various user types (admin, doctor, nurse, receptionist)."
  },
  "servers": [
    {
      "url": "https://api.healthcareplus.com/api/v2",
      "description": "Production server for Healthcare Plus Platform API v2"
    }
  ],
  "security": [
    {
      "OAuth2": [
        "patient:read",
        "patient:write",
        "provider:read",
        "provider:write",
        "admin:read",
        "admin:write"
      ]
    }
  ],
  "tags": [
    {
      "name": "Patients",
      "description": "Operations related to patient management, including registration, retrieval, and updates."
    },
    {
      "name": "Appointments",
      "description": "Management of patient appointments with healthcare providers."
    },
    {
      "name": "Medical Records",
      "description": "Access and management of patient medical history and records."
    },
    {
      "name": "Prescriptions",
      "description": "Handling of patient prescriptions."
    }
  ],
  "paths": {
    "/patients": {
      "post": {
        "tags": [
          "Patients"
        ],
        "summary": "Register a new patient",
        "description": "Registers a new patient in the system. Requires 'patient:write' or 'admin:write' scope. All patient data is encrypted at rest and in transit. Access is logged for HIPAA audit trail.",
        "operationId": "registerPatient",
        "security": [
          {
            "OAuth2": [
              "patient:write",
              "admin:write"
            ]
          }
        ],
        "requestBody": {
          "description": "Patient registration details. PHI must be handled securely.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientCreateRequest"
              },
              "examples": {
                "newPatient": {
                  "value": {
                    "firstName": "Jane",
                    "lastName": "Doe",
                    "dateOfBirth": "1990-05-15",
                    "gender": "female",
                    "email": "jane.doe@example.com",
                    "phone": "+15551234567",
                    "address": {
                      "street": "123 Main St",
                      "city": "Anytown",
                      "state": "CA",
                      "zipCode": "90210",
                      "country": "USA"
                    },
                    "insuranceId": "INS-987654321",
                    "bloodGroup": "A+",
                    "emergencyContact": {
                      "name": "John Doe",
                      "phone": "+15557654321",
                      "relationship": "Spouse"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Patient successfully registered.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/StandardResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Patient"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "success": {
                    "value": {
                      "timestamp": "2023-10-27T10:00:00Z",
                      "statusCode": "SUCCESS",
                      "message": "Patient registered successfully.",
                      "data": {
                        "id": "a1b2c3d4-e5f6-7890-1234-567890abcdef",
                        "firstName": "Jane",
                        "lastName": "Doe",
                        "dateOfBirth": "1990-05-15",
