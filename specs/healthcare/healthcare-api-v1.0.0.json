{
  "openapi": "3.0.3",
  "info": {
    "title": "Healthcare Plus API",
    "version": "2.0.0",
    "description": "A comprehensive RESTful API for managing patients, appointments, medical records, and prescriptions in a multi-tenant hospital management system.\nThis API is designed with HIPAA compliance in mind, ensuring secure handling of Protected Health Information (PHI) through robust access controls, audit logging, and encryption at rest and in transit.\nIt supports role-based access (admin, doctor, nurse, receptionist) via OAuth 2.0 and adheres to HL7 FHIR-compatible resource naming where applicable.\nAll PHI access is logged for audit trails, and provider access requires two-factor authentication with a 15-minute session timeout for inactivity.\n\n**Key Features:**\n*   **Patient Management:** Register, retrieve, update, and soft-delete patient information.\n*   **Appointment Scheduling:** Schedule, list, reschedule, and cancel appointments.\n*   **Medical Records:** Add and retrieve patient medical history and specific records.\n*   **Prescription Management:** Create, view, and update prescription statuses.\n\n**Compliance & Security:**\n*   HIPAA compliant (PHI data encryption at rest and in transit).\n*   HL7 FHIR compatible resource naming.\n*   Audit logging on all patient data access.\n*   Role-based access: admin, doctor, nurse, receptionist.\n\n**Non-Functional Requirements:**\n*   High availability and scalability.\n*   Low latency for critical operations.\n*   Comprehensive audit logging.\n*   Multi-tenant architecture."
  },
  "servers": [
    {
      "url": "https://api.healthcareplus.com/v2",
      "description": "Production server"
    },
    {
      "url": "https://dev.healthcareplus.com/v2",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "Patients",
      "description": "Operations related to patient management."
    },
    {
      "name": "Appointments",
      "description": "Operations related to appointment scheduling."
    },
    {
      "name": "Medical Records",
      "description": "Operations related to patient medical history."
    },
    {
      "name": "Prescriptions",
      "description": "Operations related to prescription management."
    }
