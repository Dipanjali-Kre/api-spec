            "$ref": "#/components/parameters/patientIdParam"
          }
        ],
        "requestBody": {
          "description": "Medical record details to add.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MedicalRecordCreateRequest"
              },
              "examples": {
                "newRecord": {
                  "value": {
                    "recordDate": "2023-10-27T11:00:00Z",
                    "recordType": "diagnosis",
