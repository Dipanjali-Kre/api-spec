        "summary": "Add a new medical record for a patient",
        "description": "Adds a new medical record for the specified patient. Requires 'provider:write' or 'admin:write' scope. All record data is encrypted and access is logged for HIPAA compliance.",
        "operationId": "addMedicalRecord",
        "security": [
          {
            "OAuth2": [
              "provider:write",
              "admin:write"
            ]
          }
        ],
        "parameters": [
