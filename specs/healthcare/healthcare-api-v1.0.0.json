{
  "openapi": "3.0.3",
  "info": {
    "title": "HealthCare Plus Platform API",
    "version": "2.0.0",
    "description": "A comprehensive RESTful API for managing patients, appointments, medical records, and prescriptions within a multi-tenant hospital management system. This API is designed with HIPAA compliance in mind, ensuring secure handling of Protected Health Information (PHI) and robust access controls. It aims for HL7 FHIR compatibility in resource naming where applicable. All patient data access is subject to audit logging and role-based access control (admin, doctor, nurse, receptionist). The API enforces a rate limit of 100 requests/minute per API key.",
    "contact": {
      "name": "Engineering Team",
      "email": "support@healthcareplus.com"
    }
  },
  "servers": [
    {
      "url": "https://api.healthcareplus.com/api/v2",
      "description": "Production server"
    },
    {
      "url": "https://staging.healthcareplus.com/api/v2",
      "description": "Staging server"
    }
  ],
  "security": [
    {
      "OAuth2": [
        "patient:read",
        "patient:write",
        "appointment:read",
        "appointment:write",
        "record:read",
        "record:write"
      ]
    }
  ],
  "tags": [
    {
      "name": "Patients",
      "description": "Operations related to patient management"
    },
    {
      "name": "Appointments",
      "description": "Operations related to scheduling and managing appointments"
    },
    {
      "name": "Medical Records",
      "description": "Operations related to patient medical history and records"
    }
  ],
  "paths": {
    "/patients": {
      "get": {
        "tags": [
          "Patients"
        ],
        "summary": "Retrieve a list of patients",
        "description": "Returns a paginated list of all patients registered in the system. Accessible by roles with `patient:read` scope.",
        "operationId": "listPatients",
        "parameters": [
          {
            "$ref": "#/components/parameters/LimitParam"
          },
          {
            "$ref": "#/components/parameters/OffsetParam"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of patients.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientsList"
                },
                "examples": {
                  "patientsListExample": {
                    "value": {
                      "items": [
                        {
                          "id": "pat_123",
                          "firstName": "John",
                          "lastName": "Doe",
                          "dateOfBirth": "1980-01-15",
                          "gender": "Male",
                          "contact": {
                            "email": "john.doe@example.com",
                            "phone": "+15551234567"
                          },
                          "address": {
                            "street": "123 Main St",
                            "city": "Anytown",
                            "state": "CA",
                            "zipCode": "90210",
                            "country": "USA"
                          },
                          "tenantId": "tenant_A"
                        }
                      ],
                      "total": 1,
                      "limit": 10,
                      "offset": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": [
              "patient:read"
            ]
          }
        ]
      },
      "post": {
        "tags": [
          "Patients"
        ],
        "summary": "Create a new patient record",
        "description": "Adds a new patient to the system. Requires `patient:write` scope.",
        "operationId": "createPatient",
        "requestBody": {
          "description": "Patient object to be created",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientCreate"
              },
              "examples": {
                "newPatient": {
                  "value": {
                    "firstName": "Jane",
                    "lastName": "Smith",
                    "dateOfBirth": "1992-03-20",
                    "gender": "Female",
                    "contact": {
                      "email": "jane.smith@example.com",
                      "phone": "+15559876543"
                    },
                    "address": {
                      "street": "456 Oak Ave",
                      "city": "Otherville",
                      "state": "NY",
                      "zipCode": "10001",
                      "country": "USA"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Patient created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Patient"
                },
                "examples": {
                  "createdPatient": {
                    "value": {
                      "id": "pat_456",
                      "firstName": "Jane",
                      "lastName": "Smith",
                      "dateOfBirth": "1992-03-20",
                      "gender": "Female",
                      "contact": {
                        "email": "jane.smith@example.com",
                        "phone": "+15559876543"
                      },
                      "address": {
                        "street": "456 Oak Ave",
                        "city": "Otherville",
                        "state": "NY",
                        "zipCode": "10001",
                        "country": "USA"
                      },
                      "tenantId": "tenant_A"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": [
              "patient:write"
            ]
          }
        ]
      }
    },
