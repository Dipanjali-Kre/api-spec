          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": [
              "patient:write"
            ]
          }
        ]
      }
    },
    "/appointments": {
      "get": {
        "tags": [
          "Appointments"
        ],
        "summary": "Retrieve a list of appointments",
        "description": "Returns a paginated list of all appointments. Can be filtered by patient ID. Requires `appointment:read` scope.",
        "operationId": "listAppointments",
        "parameters": [
          {
            "$ref": "#/components/parameters/LimitParam"
          },
          {
            "$ref": "#/components/parameters/OffsetParam"
          },
          {
            "name": "patientId",
            "in": "query",
            "description": "Filter appointments by patient ID",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^pat_[a-zA-Z0-9]{3,}$"
            },
            "example": "pat_123"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of appointments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentsList"
                },
                "examples": {
                  "appointmentsListExample": {
                    "value": {
                      "items": [
                        {
                          "id": "app_789",
                          "patientId": "pat_123",
                          "doctorId": "doc_456",
                          "appointmentDate": "2024-07-20T10:00:00Z",
                          "reason": "Annual check-up",
                          "status": "Scheduled",
                          "tenantId": "tenant_A"
                        }
                      ],
                      "total": 1,
                      "limit": 10,
                      "offset": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": [
              "appointment:read"
            ]
          }
        ]
      },
