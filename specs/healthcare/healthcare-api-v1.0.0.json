          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "OAuth2": [
              "patient:write"
            ]
          }
        ]
      },
      "delete": {
        "tags": [
          "Patients"
        ],
        "summary": "Delete a patient record",
        "description": "Deletes a patient record from the system. This operation is irreversible. Requires `patient:write` scope.",
        "operationId": "deletePatient",
        "parameters": [
          {
            "$ref": "#/components/parameters/PatientIdParam"
          }
        ],
        "responses": {
          "204": {
            "description": "Patient deleted successfully. No content."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
